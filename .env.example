# ============================================
# MR Muavia MD BOT - Environment Configuration
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file - it contains secrets.
# ============================================

# --- Bot Branding (safe to leave as-is, or customize) ---
BOT_NAME=MR Muavia MD BOT
OWNER_NAME=MR MUAVIA
OWNER_NUMBER=923200799496
OWNER_DISPLAY_NUMBER=03200799496
WELCOME_MESSAGE=welcome MUAVIA MD
LOGO_URL=https://i.ibb.co/GyZMhVd/botdp.jpg
CHANNEL_URL=https://whatsapp.com/channel/0029VbAYFuA7z4kXHVNHfM1Y

# --- Telegram (optional) ---
# Only needed if you want pairing codes delivered via a Telegram bot.
# Get a token from @BotFather on Telegram. Leave blank to disable this feature.
TELEGRAM_BOT_TOKEN=YOUR_TOKEN_HERE

# --- AI / .ai command (optional) ---
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo

# --- Giphy (optional, has a public fallback key already) ---
GIPHY_API_KEY=

# --- Tenor (required only for .emojimix) ---
# Get a free key at https://developers.google.com/tenor
TENOR_API_KEY=

# --- YouTube Data API (optional, only needed for .islamic video auto-posting) ---
# Get a free key at https://developers.google.com/youtube/registering_an_application
YOUTUBE_API_KEY=

# --- Islamic Auto-Posting (optional defaults) ---
DEFAULT_CITY=Lahore
DEFAULT_COUNTRY=Pakistan
DEFAULT_TIMEZONE=Asia/Karachi

# --- Server ---
PORT=3000
# Public URL of this instance, used only for the built-in anti-sleep ping.
# Leave as default for local/Termux use.
APP_URL=http://localhost:3000
